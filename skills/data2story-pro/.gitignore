# Dependencies
node_modules/

# Python caches
__pycache__/
*.pyc

# Logs
*.log

# Generated per-run audit output
**/audit/
# ...but DO ship the eval fixtures' audit/ payloads — they are test INPUTS, not run output
!evals/fixtures/**/audit/
!evals/fixtures/**/audit/**

# Generated eval reports (the reports/ dir itself is kept via .gitkeep)
evals/reports/*.json
evals/reports/*.md

# Superseded reference material (kept locally, never shipped)
_archive/

# Session living-docs from idea-mode brainstorming
brainstorm-*.md

# Secrets — API keys are read from the environment / ~/.env, never from the repo
.env
.env.local

# OS / editor cruft
.DS_Store
Thumbs.db
